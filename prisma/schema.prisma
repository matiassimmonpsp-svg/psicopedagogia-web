generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Modelo: Usuario
// ============================================================
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("user")     // "user" | "admin"
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  orders       Order[]
  downloads    Download[]

  @@map("users")
}

// ============================================================
// Modelo: Curso (ej: "1° Básico", "Prekínder")
// ============================================================
model Course {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  resources Resource[]

  @@map("courses")
}

// ============================================================
// Modelo: Área (ej: "Lenguaje", "Matemáticas")
// ============================================================
model Area {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  resources Resource[]
  subareas  Subarea[]

  @@map("areas")
}

// ============================================================
// Modelo: Subárea (ej: "Conciencia Fonológica")
// ============================================================
model Subarea {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String
  areaId    Int        @map("area_id")
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  area      Area       @relation(fields: [areaId], references: [id])
  resources Resource[]

  @@unique([areaId, slug])
  @@map("subareas")
}

// ============================================================
// Modelo: Recurso educativo
// ============================================================
model Resource {
  id             String         @id @default(cuid())
  title          String
  description    String
  filePath       String         @map("file_path")         // Ruta del PDF
  editablePath   String?        @map("editable_path")      // Ruta del .docx/.pptx
  previewPath    String         @map("preview_path")       // Ruta de la imagen de portada
  resourceType   String         @default("evaluation") @map("resource_type")  // "evaluation" | "educational"
  isFree         Boolean        @default(false) @map("is_free")
  priceClp       Int?           @map("price_clp")          // Precio en CLP (null si es gratis)
  promoFreeUntil DateTime?      @map("promo_free_until")   // Promo "gratis hasta" — 1 descarga por usuario
  courseId       Int            @map("course_id")
  areaId         Int            @map("area_id")
  subareaId      Int?           @map("subarea_id")
  downloadsCount Int            @default(0) @map("downloads_count")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  course         Course         @relation(fields: [courseId], references: [id])
  area           Area           @relation(fields: [areaId], references: [id])
  subarea        Subarea?       @relation(fields: [subareaId], references: [id])
  tags           ResourceTag[]
  orderItems     OrderItem[]
  downloads      Download[]

  @@map("resources")
}

// ============================================================
// Modelo: Tag / Etiqueta
// ============================================================
model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  slug      String        @unique
  resources ResourceTag[]

  @@map("tags")
}

// ============================================================
// Modelo: Relación muchos-a-muchos entre Resource y Tag
// ============================================================
model ResourceTag {
  resourceId String   @map("resource_id")
  tagId      Int      @map("tag_id")
  resource   Resource @relation(fields: [resourceId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([resourceId, tagId])
  @@map("resource_tags")
}

// ============================================================
// Modelo: Orden / Pedido
// status: "cart" | "completed"
// ============================================================
model Order {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  totalClp      Int          @map("total_clp")
  status        String       @default("pending")     // "cart" | "completed"
  paymentMethod String?      @map("payment_method")
  paymentId     String?      @map("payment_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  user          User         @relation(fields: [userId], references: [id])
  items         OrderItem[]

  @@map("orders")
}

// ============================================================
// Modelo: Item dentro de una orden
// onDelete: Cascade — al borrar la orden se borran sus items
// ============================================================
model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    String   @map("order_id")
  resourceId String   @map("resource_id")
  priceClp   Int      @map("price_clp")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id])

  @@map("order_items")
}

// ============================================================
// Modelo: Registro de descarga
// ============================================================
model Download {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id")
  resourceId   String   @map("resource_id")
  downloadedAt DateTime @default(now()) @map("downloaded_at")
  ipAddress    String?  @map("ip_address")
  user         User     @relation(fields: [userId], references: [id])
  resource     Resource @relation(fields: [resourceId], references: [id])

  @@map("downloads")
}

// ============================================================
// Modelo: Código de descuento
// ============================================================
model DiscountCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  discountPct Int       @map("discount_pct")
  maxUses     Int?      @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("discount_codes")
}

// ============================================================
// Modelo: Post de Instagram (mock / real)
// ============================================================
model SocialPost {
  id              Int      @id @default(autoincrement())
  instagramPostId String   @map("instagram_post_id")
  mediaUrl        String   @map("media_url")
  caption         String?
  permalink       String?
  postedAt        DateTime @default(now()) @map("posted_at")

  @@map("social_posts")
}
