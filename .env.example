# ============================================================
# Variables de Entorno - Psicopedagogía Web
# ============================================================

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psicopedagogia_dev?schema=public"

# URL del sitio (para metadata y redireccionamientos)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# JWT Secret (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="generar-con-openssl-rand-hex-64"

# ============================================================
# Rate Limiting (Obligatorio en producción)
# ============================================================
# Upstash Redis para rate limiting en producción multi-instancia
# Sin esto, el rate limiting usa memoria local (no comparte entre instancias de Vercel)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================
# CSRF Protection (Opcional)
# ============================================================
# Dominios permitidos separados por coma (ej: https://tu-dominio.cl,https://www.tu-dominio.cl)
# ALLOWED_ORIGINS=""

# ============================================================
# IP Hashing (Opcional - para GDPR)
# ============================================================
# Sal para hashear IPs en downloads (generar con: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")
# IP_HASH_SALT=""

# ============================================================
# Instagram Widget (Opcional)
# ============================================================
NEXT_PUBLIC_INSTAGRAM_USER="siimon.psp"
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID="@siimon.psp"

# ============================================================
# Logging
# ============================================================
# Nivel de log: debug, info, warn, error (default: debug en dev, info en prod)
# LOG_LEVEL="debug"

# ============================================================
# Sentry (Monitoreo de errores)
# ============================================================
# Crear cuenta en https://sentry.io y obtener DSN
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
